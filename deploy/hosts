# Lot « Ansible nickel » (07/11) : les deux Pi de Didier se déploient avec UNE commande, sans
# `-e ansible_user=… --private-key …` (geste manuel du 07/11). Utilisateur et clé au niveau du
# groupe parent `didier_pi` ; IP par défaut sur chaque hôte (mDNS cassé côté PC), surchargeable
# par `-e ansible_host=…` (les extra-vars l'emportent sur l'inventaire).
didier_pi:
  children:
    robot:
    vision:
  vars:
    ansible_user: pi
    ansible_ssh_private_key_file: "{{ lookup('env','HOME') }}/.ssh/keys/didier"

robot:
  hosts:
    r:
        # Pi 4 de rechange (série 10000000bec1ed98), sur le switch depuis le 07/11.
        ansible_host: 192.168.1.131
        local_project_dir: dadou_robot_ros
        project_ros_dir: robot
        project_name: robot
        launch_cmd: ros2 launch didier_bringup robot_app.launch.py
        # Sentinelle de build (rôle synchronise) : le nom est celui que lit
        # conf/scripts/launch-ros-in-docker.sh du projet — chemin relatif à ros2_ws/.
        # L1e-3c : dans le package du cœur (src/didier_core), plus dans le module robot de src/robot/.
        sentinelle_build: src/didier_core/change
        # Système (rôle config-hote) : alias mDNS didier.local (perdu à la réinstallation
        # du 04/11, source versionnée dans le dépôt du robot).
        paquets_hote:
            - avahi-utils
        unites_systemd:
            - "{{ local_projects_dir }}/dadou_robot_ros/conf/systemd/avahi-alias-didier.service"
        # Contrôle de fin de déploiement (rôle conteneur) : les 16 nœuds du robot seul
        # (vision_status vient du Pi vision, il n'est pas exigé ici). Un nœud renommé ou
        # ajouté au launch = cette liste à suivre (relays_node et wheels_node tournent même
        # sans carte I²C : hors robot ils restent présents).
        noeuds_attendus:
            - /didier/animations_node
            - /didier/audio_node
            - /didier/catalogue_node
            - /didier/left_arm_node
            - /didier/left_eye_node
            - /didier/lights_node
            - /didier/neck_node
            - /didier/relays_node
            - /didier/right_arm_node
            - /didier/right_eye_node
            - /didier/system_node
            - /didier/twist_deadman
            - /didier/twist_mux
            - /didier/web_bridge_node
            - /didier/wheels_bridge
            - /didier/wheels_node
        # Packages poussés dans ros2_ws/src/ (rôle synchronise) : les 3 communs (dont la lib
        # dadou_utils_ros, package à part depuis L1e-3a : plus de symlink dans le dépôt) + les
        # 6 packages ROS autonomes (le tri « sim-only hors du Pi » viendra avec machines/<hôte>/, L1e-4)
        # + le cœur didier_core (ex-package robot, qui vivait dans src/robot/ : L1e-3c). La liste
        # est gravée par test_arborescence.py ; vision et télécommande prennent
        # packages_default (vars/main.yml).
        packages:
            - theatre_contrats
            - theatre_interfaces
            - dadou_utils_ros
            - didier_core
            - didier_bringup
            - didier_description
            - didier_drive
            - didier_rehearsal
            - didier_sim
            - didier_web

# Console de pilotage sur Pi 4 + écran (hostname control, Pi OS Full trixie,
# flashé le 2026-07-04). Alias ssh "c" (User pi, clé didier). Ne pas confondre
# avec le groupe "controller" d'install-controller-ubuntu.yml (ancienne console
# Ubuntu/ROS hôte) : ici tout tourne en Docker comme sur le robot.
control:
  hosts:
    c:
        local_project_dir: dadou_control_ros
        project_ros_dir: controller
        project_name: controller
        launch_cmd: ros2 run controller controller_node --ros-args -r __ns:=/didier

disk:
  hosts:
    d:
        local_project_dir: dadou_hardrive_ros
        project_ros_dir: hardrive
        project_name: hardrive

sceno:
  hosts:
    s:
        local_project_dir: dadou_sceno_ros
        project_ros_dir: sceno
        project_name: sceno

vision:
  hosts:
    ai:
        local_project_dir: dadou_vision_ros
        project_ros_dir: vision
        project_name: vision
        # Heartbeat V0 (didier_bringup était un copier-coller du groupe robot,
        # ce package n'existe pas côté vision). Deviendra un launch file en V1.
        launch_cmd: ros2 run didier_vision vision_status --ros-args -r __ns:=/didier
        # L1e-3d (08/11) : la vision est le package packages/didier_vision ; les 3 communs + lui.
        packages:
            - theatre_contrats
            - theatre_interfaces
            - dadou_utils_ros
            - didier_vision
        ansible_host: 192.168.1.151
        # Sentinelle dans le package (gitignorée), lue par conf/scripts/launch-ros-in-docker.sh.
        sentinelle_build: src/didier_vision/change
        # Alias ALSA par NOM de carte (mixette, casque_mic, webcam_mic), bind-monté en
        # lecture seule dans le conteneur (docker-compose-arm.yml de la vision).
        fichiers_etc:
            - source: "{{ local_projects_dir }}/dadou_vision_ros/conf/rpi/asound.conf"
              dest: /etc/asound.conf
        # Secrets (rôle secrets) : poussés depuis ~/.config/didier/ du PC, jamais du dépôt.
        # `modele` = la liste des clés attendues ; toute clé non commentée du modèle doit
        # exister dans la source, sinon échec (noms de clés seulement dans le message).
        secrets_hote:
            - source: vision-conf-secret
              dest: ros2_ws/src/vision/conf/secret
              modele: "{{ local_projects_dir }}/dadou_vision_ros/conf/secret.example"
        # Monté par le compose (../../../medias) mais absent du dépôt de la vision.
        dossiers_montes:
            - medias
        # Voix Piper de Didier (chat_node : vision_config « chat_piper_voice » =
        # medias/voices/didier.onnx). Sous medias/ bind-monté : la copie de l'image est masquée,
        # c'est donc CELLE-CI qui sert. Empreintes = fichiers du proto validé le 10/07.
        telechargements_hote:
            - url: https://huggingface.co/rhasspy/piper-voices/resolve/main/fr/fr_FR/siwis/medium/fr_FR-siwis-medium.onnx
              dest: ros2_ws/src/vision/medias/voices/didier.onnx
              sha256: 641d1ab097da2b81128c076810edb052b385decc8be3381814802a64a73baf99
            - url: https://huggingface.co/rhasspy/piper-voices/resolve/main/fr/fr_FR/siwis/medium/fr_FR-siwis-medium.onnx.json
              dest: ros2_ws/src/vision/medias/voices/didier.onnx.json
              sha256: 39479916c2db192b5ac9764daddd0c744d83e023ad890c6976c0633ae4df8959
        # person_tracker n'est pas exigé : sans webcam (Pi hors robot) il s'arrête.
        noeuds_attendus:
            - /didier/vision_status

robot-test:
  hosts:
    test:
        local_project_dir: dadou_robot_ros
        project_ros_dir: robot
        project_name: robot

glove-left:
  hosts:
    gl:
        # Paquets apt (information seule, aucun rôle ne les lit). Renommé : `packages` est
        # désormais la liste des packages ROS du rôle synchronise — l'ancien nom aurait fait
        # rsync-er des dossiers « vim »... inexistants.
        apt_packages:
            - vim
            - libgirepository1.0-dev
            - libasound2-dev
        local_project_dir: dadou_control_ros
        local_utils_dir: dadou_utils_ros_ros
        project_ros_dir: controller
        project_name: controller
        launch_cmd: ros2 run controller controller_node --ros-args -r __ns:=/didier


