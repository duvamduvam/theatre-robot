# Inventaire SEUL (lot L1e-4c, 11/11) : groupes, IP, utilisateur, clé — et, par hôte, `machine:`
# = le dossier machines/<machine>/ dont le machine.yml dit CE QUI tourne sur l'hôte (packages,
# launch, nœuds attendus, secrets, fichiers système…), chargé par `include_vars` au début de
# deploy-pios.yml et install-pios-lite.yml. Aucune variable de contenu ici (gravé par
# packages/didier_core/test/unit/test_arborescence.py). Convention : machines/README.md.
# Lot « Ansible nickel » (07/11) : les deux Pi de Didier se déploient avec UNE commande, sans
# `-e ansible_user=… --private-key …` (geste manuel du 07/11). Utilisateur et clé au niveau du
# groupe parent `didier_pi` ; IP par défaut sur chaque hôte (mDNS cassé côté PC), surchargeable
# par `-e ansible_host=…` (les extra-vars l'emportent sur l'inventaire).
didier_pi:
  children:
    robot:
    vision:
  vars:
    ansible_user: pi
    ansible_ssh_private_key_file: "{{ lookup('env','HOME') }}/.ssh/keys/didier"

robot:
  hosts:
    r:
        # Pi 4 de rechange (série 10000000bec1ed98), sur le switch depuis le 07/11.
        ansible_host: 192.168.1.131
        machine: robot

# Console de pilotage sur Pi 4 + écran (hostname control). Alias ssh "c" (User pi, clé didier).
# Ne pas confondre avec le groupe "controller" d'install-controller-ubuntu.yml (ancienne console
# Ubuntu/ROS hôte).
control:
  hosts:
    c:
        machine: telecommande

disk:
  hosts:
    d:
        machine: disque

sceno:
  hosts:
    s:
        machine: sono

vision:
  hosts:
    ai:
        ansible_host: 192.168.1.151
        machine: vision

# Hôte de test sans adresse : une seconde machine « robot ».
robot-test:
  hosts:
    test:
        machine: robot

glove-left:
  hosts:
    gl:
        machine: gant-gauche

glove-right:
  hosts:
    gr:
        machine: gant-droit
