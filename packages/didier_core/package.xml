<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>didier_core</name>
  <version>0.1.0</version>
  <description>Cœur embarqué du robot de théâtre Didier (servos, roues, LEDs, audio, animations). Ex-package robot (lot L1e-3c) ; ses données (json/, medias/, db/, conf/) restent hors du package, racine DIDIER_DATA_DIR.</description>
  <maintainer email="achats@duvam.net">dadou</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>theatre_interfaces</depend>
  <!-- Contrat commun (lot L1a, packages/theatre_contrats) : codec StringTime et noms
       de topics ; dadou_utils_ros/utils_static.py (shim) l'importe aussi. -->
  <exec_depend>theatre_contrats</exec_depend>
  <!-- Lib partagée (L1e-3a : package de packages/, plus un symlink du dépôt). -->
  <exec_depend>dadou_utils_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
