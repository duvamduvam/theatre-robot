<?xml version="1.0"?>
<!--
  Monde "rue" (répétition simulée, étude §12) : un trottoir de 70 m, une
  chaussée abaissée, des façades, du mobilier et un hangar à bananes au bout.
  Boîtes/cylindres uniquement : pas de mesh, pas de Fuel (aucune dépendance
  réseau). Le rendu sert à une webcam de console, pas à un film.
  Repère : x = le long de la rue, y = travers, z = vertical (mètres).

  CONTRAT : le monde s'appelle "stage" ICI AUSSI. Le bridge
  (config/gz_bridge.yaml) et leds_sim_node ciblent /world/stage/material_color :
  renommer le monde casserait silencieusement le visage LED en sim. Seul le
  FICHIER change (argument `world:=rue` du launch).

  Pas de ground plane : les dalles trottoir/chaussée font le sol. Sortir de la
  rue (x < -5 ou x > 65, hors des dalles) = chute dans le vide, voulu.
-->
<sdf version="1.10">
  <world name="stage">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Système Sensors : indispensable au rendu de la caméra embarquée
         (camera_link, cf. dadou_robot_gz.urdf.xacro) : sans lui aucune image
         n'est publiée. Le monde peut alors demander un moteur de rendu même en
         headless (ogre2 off-screen) : le retour vidéo du pont web fonctionne
         donc aussi sans GUI Gazebo. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

     <!-- Trottoir côté y positif : SURFACE À z = 0 (Didier y est posé par le launch à (0,0,0.24), comme sur la scène). x de -5 à 65, y de -1.5 à 1.5. -->
    <model name="trottoir">
      <static>true</static>
      <link name="dalle">
        <pose>30 0 -0.06 0 0 0</pose>
        <collision name="collision"><geometry><box><size>70 3 0.12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>70 3 0.12</size></box></geometry><material><ambient>0.43 0.42 0.40 1</ambient><diffuse>0.62 0.60 0.57 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Chaussée 12 cm PLUS BAS que le trottoir : la bordure est un vrai ressaut où Didier peut se bloquer (voulu, cf. étude §2 « ressaut de trottoir »). Marquage = visuel seul (1 mm, sans collision). -->
    <model name="chaussee">
      <static>true</static>
      <link name="asphalte">
        <pose>30 -5 -0.18 0 0 0</pose>
        <collision name="collision"><geometry><box><size>70 7 0.12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>70 7 0.12</size></box></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material></visual>
      </link>
      <link name="marquage">
        <pose>30 -5 -0.119 0 0 0</pose>
        <visual name="visual"><geometry><box><size>70 0.15 0.001</size></box></geometry><material><ambient>0.66 0.66 0.66 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Trottoir d'en face, même niveau que le nôtre. -->
    <model name="trottoir_oppose">
      <static>true</static>
      <link name="dalle">
        <pose>30 -10 -0.06 0 0 0</pose>
        <collision name="collision"><geometry><box><size>70 3 0.12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>70 3 0.12</size></box></geometry><material><ambient>0.41 0.39 0.38 1</ambient><diffuse>0.58 0.56 0.54 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Murs continus derrière chaque trottoir (la rue est un canyon : la caméra a toujours un fond). -->
    <model name="facades">
      <static>true</static>
      <link name="mur_nord">
        <pose>30 1.7 2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>70 0.4 4</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>70 0.4 4</size></box></geometry><material><ambient>0.59 0.55 0.43 1</ambient><diffuse>0.85 0.78 0.62 1</diffuse></material></visual>
      </link>
      <link name="mur_sud">
        <pose>30 -11.7 2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>70 0.4 4</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>70 0.4 4</size></box></geometry><material><ambient>0.56 0.52 0.46 1</ambient><diffuse>0.80 0.74 0.66 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Façade colorée incrustée devant le mur nord (épaisseur 0,1 m : 1,40 < y < 1,50) + enseigne jaune. -->
    <model name="boulangerie">
      <static>true</static>
      <link name="vitrine">
        <pose>28 1.45 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6 0.1 3</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>6 0.1 3</size></box></geometry><material><ambient>0.43 0.22 0.10 1</ambient><diffuse>0.62 0.32 0.14 1</diffuse></material></visual>
      </link>
      <link name="enseigne">
        <pose>28 1.4 3.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5 0.1 0.5</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>5 0.1 0.5</size></box></geometry><material><ambient>0.66 0.56 0.10 1</ambient><diffuse>0.95 0.80 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Le but, au bout de la rue : il BARRE la rue (voulu). Banane = cylindre couché (pitch 1,5708) sur le toit. -->
    <model name="hangar_bananes">
      <static>true</static>
      <link name="hangar">
        <pose>66 -4 3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8 8 6</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>8 8 6</size></box></geometry><material><ambient>0.32 0.33 0.35 1</ambient><diffuse>0.45 0.47 0.50 1</diffuse></material></visual>
      </link>
      <link name="banane">
        <pose>66 -4 6.8 0 1.5708 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>4</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>4</length></cylinder></geometry><material><ambient>0.70 0.62 0.03 1</ambient><diffuse>1.00 0.88 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Lampadaire : mât + lanterne émissive. -->
    <model name="lampadaire_1">
      <static>true</static>
      <link name="mat">
        <pose>10 1.2 2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry><material><ambient>0.17 0.17 0.19 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
      </link>
      <link name="lanterne">
        <pose>10 1.2 4.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><material><ambient>0.70 0.70 0.70 1</ambient><diffuse>1.00 1.00 1.00 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
      </link>
    </model>

    <model name="lampadaire_2">
      <static>true</static>
      <link name="mat">
        <pose>30 1.2 2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry><material><ambient>0.17 0.17 0.19 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
      </link>
      <link name="lanterne">
        <pose>30 1.2 4.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><material><ambient>0.70 0.70 0.70 1</ambient><diffuse>1.00 1.00 1.00 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
      </link>
    </model>

    <model name="lampadaire_3">
      <static>true</static>
      <link name="mat">
        <pose>50 1.2 2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry><material><ambient>0.17 0.17 0.19 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material></visual>
      </link>
      <link name="lanterne">
        <pose>50 1.2 4.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><material><ambient>0.70 0.70 0.70 1</ambient><diffuse>1.00 1.00 1.00 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- Banc en bois contre la façade. -->
    <model name="banc">
      <static>true</static>
      <link name="assise">
        <pose>18 1.1 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.8 0.5 0.45</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.8 0.5 0.45</size></box></geometry><material><ambient>0.35 0.23 0.12 1</ambient><diffuse>0.50 0.33 0.17 1</diffuse></material></visual>
      </link>
    </model>

    <model name="poubelle">
      <static>true</static>
      <link name="fut">
        <pose>40 1.15 0.45 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry><material><ambient>0.08 0.21 0.10 1</ambient><diffuse>0.12 0.30 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Terrasse de café : 2 tables + 4 chaises (y >= 0,5) qui EMPIÈTENT sur le trottoir : obstacle à contourner (ou par la chaussée... et son ressaut). -->
    <model name="terrasse">
      <static>true</static>
      <link name="table_1">
        <pose>45 0.9 0.375 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.75</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.75</length></cylinder></geometry><material><ambient>0.49 0.39 0.24 1</ambient><diffuse>0.70 0.55 0.35 1</diffuse></material></visual>
      </link>
      <link name="table_2">
        <pose>47 0.9 0.375 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.75</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.75</length></cylinder></geometry><material><ambient>0.49 0.39 0.24 1</ambient><diffuse>0.70 0.55 0.35 1</diffuse></material></visual>
      </link>
      <link name="chaise_1">
        <pose>44.4 0.9 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><material><ambient>0.39 0.14 0.10 1</ambient><diffuse>0.55 0.20 0.15 1</diffuse></material></visual>
      </link>
      <link name="chaise_2">
        <pose>45.6 0.9 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><material><ambient>0.39 0.14 0.10 1</ambient><diffuse>0.55 0.20 0.15 1</diffuse></material></visual>
      </link>
      <link name="chaise_3">
        <pose>46.4 0.9 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><material><ambient>0.39 0.14 0.10 1</ambient><diffuse>0.55 0.20 0.15 1</diffuse></material></visual>
      </link>
      <link name="chaise_4">
        <pose>47.6 0.9 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><material><ambient>0.39 0.14 0.10 1</ambient><diffuse>0.55 0.20 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- « Le chien » : obstacle bas sur le trottoir. -->
    <model name="chien">
      <static>true</static>
      <link name="corps">
        <pose>36 0.3 0.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.25 0.4</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.6 0.25 0.4</size></box></geometry><material><ambient>0.28 0.18 0.10 1</ambient><diffuse>0.40 0.26 0.14 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Voitures garées sur la chaussée (surface -0,12, donc centre z = -0,12 + 0,70). -->
    <model name="voiture_1">
      <static>true</static>
      <link name="caisse">
        <pose>15 -2.2 0.58 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4 1.8 1.4</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>4 1.8 1.4</size></box></geometry><material><ambient>0.49 0.08 0.08 1</ambient><diffuse>0.70 0.12 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <model name="voiture_2">
      <static>true</static>
      <link name="caisse">
        <pose>42 -2.2 0.58 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4 1.8 1.4</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>4 1.8 1.4</size></box></geometry><material><ambient>0.10 0.21 0.45 1</ambient><diffuse>0.15 0.30 0.65 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
