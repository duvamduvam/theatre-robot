<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>didier_sim</name>
  <version>0.1.0</version>
  <description>Simulation Gazebo (gz-sim Harmonic) du robot de théâtre Dadou : monde, bridge ros_gz, launch</description>
  <maintainer email="achats@duvam.net">dadou</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>didier_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- leds_sim_node : visualisation LED par matériaux émissifs gz (MaterialColor). -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>theatre_interfaces</exec_depend>
  <!-- Lot L1d : leds_sim_node relit les lumières sur verdict data_edit_result (theatre_contrats.donnees). -->
  <exec_depend>theatre_contrats</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
