<?xml version="1.0"?>
<!--
  Monde "scène de théâtre" minimal : sol plan + lumière.
  Le plateau fait 10 x 8 m (une scène raisonnable), Didier est posé dessus
  par le launch. Pas de capteurs pour l'instant : la physique seule suffit
  (le serveur tourne donc aussi en headless, sans GPU).
-->
<sdf version="1.10">
  <world name="stage">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Système Sensors : indispensable au rendu de la caméra embarquée
         (camera_link, cf. dadou_robot_gz.urdf.xacro) -- sans lui aucune image
         n'est publiée. Le monde peut alors demander un moteur de rendu même en
         headless (ogre2 off-screen) : le retour vidéo du pont web fonctionne
         donc aussi sans GUI Gazebo. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="stage_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 8</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 8</size>
            </plane>
          </geometry>
          <material>
            <!-- Plancher de scène : brun sombre -->
            <ambient>0.25 0.18 0.12 1</ambient>
            <diffuse>0.35 0.25 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======== Corps sûr (spec A0 §8.4) : obstacle et passant scriptés ========
         Tous deux STATIQUES (sans physique : ils ne poussent pas Didier, on mesure une
         distance, pas un choc), créés une fois HORS CHAMP (au-delà des 12 m du lidar) et
         déplacés par le service gz /world/stage/set_pose (système UserCommands ci-dessus),
         comme les téléportations des épreuves existantes. -->

    <!-- Obstacle : cylindre r 0,15 m, h 1 m. PosePublisher = VÉRITÉ TERRAIN des épreuves
         (100 Hz, pose du modèle seule, bridgée vers sim/obstacle_pose par gz_bridge.yaml) :
         T0 d'une apparition = horodatage du DERNIER message qui le montre encore à l'ancienne
         place (spec §8.5). static_publisher=false : un modèle statique publie alors sur le
         topic ordinaire, à la cadence demandée, au lieu d'un unique message « pose_static ». -->
    <model name="obstacle">
      <static>true</static>
      <pose>50 0 0.5 0 0 0</pose>
      <link name="corps">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.4 0.1 1</ambient>
            <diffuse>0.9 0.5 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>100</update_frequency>
      </plugin>
    </model>

    <!-- Passant : cylindre r 0,20 m, h 1,7 m, déplacé à 20 Hz par passant_sim_node
         (didier_sim) le long d'un segment demandé sur sim/passant. -->
    <model name="passant">
      <static>true</static>
      <pose>55 0 0.85 0 0 0</pose>
      <link name="corps">
        <collision name="collision">
          <geometry><cylinder><radius>0.20</radius><length>1.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.20</radius><length>1.7</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.3 0.7 1</ambient>
            <diffuse>0.3 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
