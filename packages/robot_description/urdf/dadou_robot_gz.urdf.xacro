<?xml version="1.0"?>
<!--
  Extension Gazebo (gz-sim / Harmonic) du robot Dadou.

  Inclut l'URDF nominal (dadou_robot.urdf.xacro, inchangé : il reste la
  description commune vrai robot / RViz / sim) et y ajoute uniquement ce
  qui n'existe qu'en simulation :
   - plugin DiffDrive : consomme /cmd_vel (Twist), publie /odom + TF.
     C'est LE premier consommateur de l'interface standard cmd_vel —
     le vrai wheels_node migrera vers la même interface en Phase 2.
   - plugin JointStatePublisher : publie les positions de tous les joints.
   - un JointPositionController par servo, topic /<servo>/position,
     mêmes noms que les servos du code (neck, left_arm, right_arm,
     left_eye, right_eye).
   - friction quasi nulle sur la roue folle (sphère glissante).

  L'include est relatif : le fichier reste traitable par le xacro pip
  des tests unitaires, sans environnement ament.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dadou_robot">

  <xacro:include filename="dadou_robot.urdf.xacro"/>

  <!-- LED : joints fixes qu'il ne faut PAS laisser "lumper" par la conversion
       URDF->SDF (sinon leurs visuals fusionnent dans le lien parent, avec un nom
       du style "base_link_fixed_joint_lump__torso_link_visual_2" imprévisible).
       preserveFixedJoint garde <link>_visual comme visual distinct, avec un nom
       stable pour le bridge MaterialColor (voir robot_sim/scripts/leds_sim_node
       + config/gz_bridge.yaml).
       Les yeux ont désormais une COQUE (cloche en cylindres étagés) en plus de
       leur matrice : leur matrice a donc son propre link, comme le corps et la
       bouche, au lieu de compter sur "le seul visual du link œil". -->
  <gazebo reference="body_leds_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="mouth_leds_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="left_eye_leds_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="right_eye_leds_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- ======== Caméra embarquée (SIM-ONLY, retour vidéo du pont web W3) ========
       Petit link fixe regardant vers +x (l'avant du robot). preserveFixedJoint
       pour que camera_link ne soit PAS fusionné dans son parent à la conversion
       URDF vers SDF (même piège que les LED) ; sinon la référence gazebo du
       capteur ne trouverait plus son link et la caméra ne serait pas montée. -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <xacro:box_inertial m="0.05" x="0.03" y="0.05" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <!-- FIXÉE AU BUSTE (torso_link), PAS à la tête : sur le vrai robot la
         webcam est sur un support du buste, devant la bouche, et ne tourne PAS
         avec le servo neck (établi par David le 2026-09-14, cf.
         docs/hardware/overview.md §Vision & camera). Jusqu'au 22/10 la sim la
         montait sur head_link : l'image tournait avec chaque animation de
         cou (« parle »), ce que le robot réel ne fait pas. Position : bord
         avant du haut du buste, juste au-dessus du plateau (tête de rayon
         0,11 < demi-profondeur du buste 0,14 : pas de collision visuelle). -->
    <parent link="torso_link"/>
    <child link="camera_link"/>
    <origin xyz="${torso_length/2 + 0.015} 0 ${torso_height + 0.03}"/>
  </joint>
  <gazebo reference="camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- Capteur caméra gz. La caméra gz regarde le long de +x du link : orientée
       vers l'avant sans rotation. <topic> EXPLICITE (camera/image_raw) pour ne
       PAS dépendre du nom auto-généré scoppé sur le monde/modèle
       (/world/stage/model/.../sensor/.../image) ; le bridge (gz_bridge.yaml)
       s'y abonne tel quel. NB : le rendu caméra exige le système gz Sensors,
       ajouté au monde stage.sdf (sans lui, aucune image n'est publiée). -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <topic>camera/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- ======== Caméra de POURSUITE (SIM-ONLY, « Didier vu de l'extérieur ») ========
       Pour JUGER COMMENT DIDIER BOUGE (la caméra embarquée, elle, regarde devant
       depuis le buste). Fixée à base_link : elle suit ET tourne avec le robot.
       Pose (repère base_link, x avant, z haut, sol à z = -0,23) : 3 m derrière,
       2 m au-dessus, piquée de 0,45 rad (pitch>0 = l'axe +x plonge) -> vise un
       point ~3,5 m en avant à ~0,3 m au-dessus du sol : le robot (de -0,58 en x
       à +0,3, haut de ~1,4 m) tient en entier avec un peu de route devant.
       Ni visuel NI collision : la caméra ne se voit pas elle-même, ne projette
       pas d'ombre et ne gêne rien (masse/inertie minimes mais valides, donc
       négligeables même à 3 m de bras de levier). preserveFixedJoint : même
       piège que camera_link : sans lui le link fixe sans géométrie serait
       fusionné dans base_link à la conversion SDF et le capteur perdrait sa pose
       (sa référence gazebo ne trouverait plus son link). -->
  <link name="chase_camera_link">
    <xacro:box_inertial m="0.01" x="0.02" y="0.02" z="0.02"/>
  </link>
  <joint name="chase_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chase_camera_link"/>
    <origin xyz="-3.0 0 2.0" rpy="0 0.45 0"/>
  </joint>
  <gazebo reference="chase_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- Capteur : <topic> EXPLICITE (camera_ext/image_raw), comme camera/image_raw,
       pour que le bridge s'y abonne sans nom auto-généré. 10 Hz : suffit pour
       juger un mouvement et épargne le rendu de la sim. Champ 1,2 rad. -->
  <gazebo reference="chase_camera_link">
    <sensor name="chase_camera" type="camera">
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>camera_ext/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- Roue folle : elle est modélisée en sphère fixe, elle doit glisser. -->
  <gazebo reference="caster_rear_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>

  <!-- Pneus : bonne adhérence pour que le différentiel morde. -->
  <gazebo reference="wheel_left_link">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo>
    <!-- Base différentielle : mêmes wheel_separation/wheel_radius que
         robot/move/diff_drive.py (propriétés xacro partagées). -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf_gz</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <!-- Un robot de 50 kg au milieu d'acteurs n'accélère pas comme un jouet. -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <!-- VÉRITÉ TERRAIN (SIM-ONLY, salle de répétition — robot_rehearsal) :
         pose du modèle dans le repère monde, publiée en gz.msgs.Odometry et
         bridgée vers ROS /ground_truth/odom (gz_bridge.yaml). POURQUOI pas
         /odom du DiffDrive : il INTÈGRE les roues — il ne se remet pas à
         zéro quand on téléporte Didier au départ (set_pose) et il dérive au
         premier patinage sur une bordure (vécu le 2026-10-07 : téléporté à
         x=0, /odom disait toujours 59,5). Le cheminement a besoin d'une pose
         vraie ; le vrai robot n'a de toute façon aucune odométrie. tf_topic
         volontairement hors du bridge : aucune TF concurrente côté ROS. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf_unused</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

    <!-- Servos : un contrôleur en position par joint, piloté en vitesse
         (use_velocity_commands : stable sans réglage de PID). -->
    <xacro:macro name="servo_controller" params="joint">
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>/${joint}/position</topic>
        <use_velocity_commands>true</use_velocity_commands>
      </plugin>
    </xacro:macro>
    <xacro:servo_controller joint="neck"/>
    <xacro:servo_controller joint="left_arm"/>
    <xacro:servo_controller joint="right_arm"/>
    <xacro:servo_controller joint="left_eye"/>
    <xacro:servo_controller joint="right_eye"/>
  </gazebo>

</robot>
