<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>theatre_contrats</name>
  <version>0.1.0</version>
  <description>Contrat commun du parc Didier : noms de topics (relatifs), clés de payload, organes, codec StringTime, profils QoS. Python pur (stdlib), importable sans ROS.</description>
  <maintainer email="achats@duvam.net">dadou</maintainer>
  <license>MIT</license>

  <!-- Seule dépendance d'exécution : rclpy, pour qos.py, qui l'importe À
       L'APPEL — le package reste importable sur le PC sans ROS (tests hôte). -->
  <exec_depend>rclpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
