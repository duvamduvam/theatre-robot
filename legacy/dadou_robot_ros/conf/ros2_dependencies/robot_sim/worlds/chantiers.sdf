      <static>true</static>
      <link name="mail_beton">
        <pose>33.445 0 -0.06 0 0 0</pose>
        <collision name="collision"><geometry><box><size>76.89 12 0.12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>76.89 12 0.12</size></box></geometry><material><ambient>0.49 0.49 0.48 1</ambient><diffuse>0.70 0.70 0.68 1</diffuse></material></visual>
