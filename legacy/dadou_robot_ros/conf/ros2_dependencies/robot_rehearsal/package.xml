<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_rehearsal</name>
  <version>0.1.0</version>
  <description>Salle de répétition simulée du robot de théâtre Dadou (SIM-ONLY, jamais dans robot_bringup) : cheminement de Didier dans la rue, points d'intérêt</description>
  <maintainer email="achats@duvam.net">dadou</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>robot_interfaces</depend>
  <!-- journal JSONL (robot.diagnostic.journal, module PUR du paquet robot) -->
  <exec_depend>robot</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
