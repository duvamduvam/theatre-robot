robot:
  hosts:
    r:
        local_project_dir: dadou_robot_ros
        project_ros_dir: robot
        project_name: robot
        launch_cmd: ros2 launch didier_bringup robot_app.launch.py
        # Packages poussés dans ros2_ws/src/ (rôle synchronise) : les 3 communs (dont la lib
        # dadou_utils_ros, package à part depuis L1e-3a : plus de symlink dans le dépôt) + les
        # 6 packages ROS autonomes (le tri « sim-only hors du Pi » viendra avec machines/<hôte>/, L1e-4). La liste
        # est gravée par test_arborescence.py ; vision et télécommande prennent
        # packages_default (vars/main.yml).
        packages:
            - theatre_contrats
            - robot_interfaces
            - dadou_utils_ros
            - didier_bringup
            - didier_description
            - didier_drive
            - didier_rehearsal
            - didier_sim
            - didier_web

# Console de pilotage sur Pi 4 + écran (hostname control, Pi OS Full trixie,
# flashé le 2026-07-04). Alias ssh "c" (User pi, clé didier). Ne pas confondre
# avec le groupe "controller" d'install-controller-ubuntu.yml (ancienne console
# Ubuntu/ROS hôte) : ici tout tourne en Docker comme sur le robot.
control:
  hosts:
    c:
        local_project_dir: dadou_control_ros
        project_ros_dir: controller
        project_name: controller
        launch_cmd: ros2 run controller controller_node --ros-args -r __ns:=/didier

integration:
  hosts:
    ci:
        ansible_host: ci.local
        ansible_user: pi
        ansible_ssh_private_key_file: "{{ lookup('env','HOME') }}/Nextcloud/divers/keys/didier"
        local_project_dir: dadou_robot_ros
        project_ros_dir: dadou_robot
        project_name: robot
        launch_cmd: test
        jenkins_workspace: dadou_robot
  vars:
    ansible_python_interpreter: /usr/bin/python3

disk:
  hosts:
    d:
        local_project_dir: dadou_hardrive_ros
        project_ros_dir: hardrive
        project_name: hardrive

sceno:
  hosts:
    s:
        local_project_dir: dadou_sceno_ros
        project_ros_dir: sceno
        project_name: sceno

vision:
  hosts:
    ai:
        local_project_dir: dadou_vision_ros
        project_ros_dir: vision
        project_name: vision
        # Heartbeat V0 (didier_bringup était un copier-coller du groupe robot,
        # ce package n'existe pas côté vision). Deviendra un launch file en V1.
        launch_cmd: ros2 run vision vision_status --ros-args -r __ns:=/didier

robot-test:
  hosts:
    test:
        local_project_dir: dadou_robot_ros
        project_ros_dir: robot
        project_name: robot

glove-left:
  hosts:
    gl:
        # Paquets apt (information seule, aucun rôle ne les lit). Renommé : `packages` est
        # désormais la liste des packages ROS du rôle synchronise — l'ancien nom aurait fait
        # rsync-er des dossiers « vim »... inexistants.
        apt_packages:
            - vim
            - libgirepository1.0-dev
            - libasound2-dev
        local_project_dir: dadou_control_ros
        local_utils_dir: dadou_utils_ros_ros
        project_ros_dir: controller
        project_name: controller
        launch_cmd: ros2 run controller controller_node --ros-args -r __ns:=/didier


glove-right:
  hosts:
    gr:
        # Paquets apt (information seule, aucun rôle ne les lit). Renommé : `packages` est
