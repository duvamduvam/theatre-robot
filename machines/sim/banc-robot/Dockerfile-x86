# Base image with full desktop (RViz, Gazebo, etc.)
FROM osrf/ros:jazzy-desktop-full

# Metadata
LABEL authors="dadouuu"
WORKDIR /home

EXPOSE 4421

# Prepare ROS 2 workspace layout
RUN mkdir /home/ros2_ws
RUN mkdir /home/ros2_ws/src
# src/robot/ : données du cœur seulement (L1e-3c) ; le code est le package src/didier_core.
RUN mkdir /home/ros2_ws/src/robot

# Copy project sources and configuration
# conf/ de la machine robot (L1e-4c : machines/robot/), contexte nommé `conf` du compose.
COPY --from=conf . /home/ros2_ws/src/robot/conf/
# Données du robot (L1e-4b) : data/ du mono-dépôt, contexte nommé `data` du compose.
COPY --from=data json/ /home/ros2_ws/src/robot/json/
COPY --from=data medias/ /home/ros2_ws/src/robot/medias/

# Bring ROS 2 interfaces and package metadata
# Les 6 packages ROS autonomes (L1e-1 : ils vivaient dans conf/ du robot, maintenant packages/
# du mono-dépôt) : contextes nommés du compose.
COPY --from=didier_bringup . /home/ros2_ws/src/didier_bringup
COPY --from=didier_description . /home/ros2_ws/src/didier_description
COPY --from=didier_drive . /home/ros2_ws/src/didier_drive
COPY --from=didier_rehearsal . /home/ros2_ws/src/didier_rehearsal
COPY --from=didier_sim . /home/ros2_ws/src/didier_sim
COPY --from=didier_web . /home/ros2_ws/src/didier_web
# Packages communs du mono-dépôt (lot L1a) : contextes nommés du compose.
COPY --from=theatre_interfaces . /home/ros2_ws/src/theatre_interfaces
COPY --from=theatre_contrats . /home/ros2_ws/src/theatre_contrats
# dadou_utils_ros (L1e-3a) : lib partagée, package de packages/ (plus de symlink).
COPY --from=dadou_utils_ros . /home/ros2_ws/src/dadou_utils_ros
# didier_core (L1e-3c) : le cœur, ex-package robot (code + package.xml/setup.py).
COPY --from=didier_core . /home/ros2_ws/src/didier_core

# Add helper aliases/env setup for interactive shells in the container
COPY --from=conf docker/docker_bashrc /tmp/docker_bashrc
RUN cat /tmp/docker_bashrc >> /root/.bashrc && rm /tmp/docker_bashrc

# System dependencies needed by the robot stack
RUN apt-get update && grep -vE '^\s*(#|$)' /home/ros2_ws/src/robot/conf/packages-docker.txt | xargs apt-get install -y

# Ensure Python sees the project sources
ENV PYTHONPATH "${PYTHONPATH}:/home/src"

# Allow pip to coexist with Debian packages (ROS requirement)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install Python dependencies
RUN pip3 install --no-cache-dir --ignore-installed -r /home/ros2_ws/src/robot/conf/requirements.txt

#ENTRYPOINT ["/bin/bash", "-c", "source /home/ros2_ws/src/robot/conf/scripts/launch-ros-in-docker.sh"]

#COPY robot/test.py .
# Launch test entry point by default (override at runtime if needed)
# ⚠️ test.py n'existe pas dans le module (constaté au L1e-3c, 07/11) : cette image de bureau
# ne démarre pas telle quelle — chemin seulement suivi du renommage robot -> didier_core.
ENTRYPOINT ["python3", "/home/ros2_ws/src/didier_core/didier_core/test.py"]
#CMD ["python3", "src/run.py"]

